{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地知识库助手",
  "version": "0.1.0",
  "identifier": "com.example.localragapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "本地知识库助手",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/stephenxue/claude_test_01/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNTA1QjQ2REY4RjE5NEEKUldSS0dZL2ZSbHRRVUo2aWVzQ0hrbEthSUw3eWl1R0cvSG82dmdSb3ZsODdSS05BMlZUMm5uR3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
